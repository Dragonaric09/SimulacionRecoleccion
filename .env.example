# Copia este archivo como .env en la raíz del repositorio y completa los valores. .env no se versiona.

# --- Desarrollo local ---------------------------------------------------------
# Los usan docker-compose.yml (contenedor de PostgreSQL) y el perfil dev de Spring Boot.
# La contraseña es solo para tu base local; elige una propia.
DB_USER=simulacionem_dev
DB_PASSWORD=
# Puerto local de PostgreSQL (5433 para no chocar con otros proyectos en 5432).
# DB_PORT=5433

# --- Producción (Render) ------------------------------------------------------
# Variables de entorno del Web Service en Render (Environment).
# Este archivo solo documenta los nombres. Los valores reales NO van aquí ni en el repositorio:
# se escriben en Render, o en tu .env local para pruebas con Docker.

# Base de datos: copia estos valores del panel de la base en Render (Connect).
# Usa el host interno (Internal Database URL) para que la app y la base estén en la misma región.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# prefer funciona con conexión interna y externa. Si la base exige SSL, usa require.
DB_SSLMODE=prefer

# Tamaño máximo de archivo a importar (por defecto 20MB en producción, 200MB en desarrollo).
# UPLOAD_MAX_SIZE=20MB
